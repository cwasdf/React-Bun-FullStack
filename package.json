{
  "name": "react-bun-fullstack-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "build": "bun run --sequential --filter '*' --if-present build",
    "start": "bun --filter @starter/api start",
    "typecheck": "bun run --parallel --filter '*' --if-present typecheck",
    "test": "bun run --parallel --filter '*' --if-present test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
